{
  "name": "isuncloud",
  "productName": "iSunCloud",
  "version": "1.12.3",
  "description": "iSunCloud AI Blockchain Computing Platform",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron . --trace-warnings",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare:extra": "npx tsx scripts/prepare_extra.ts",
    "build": "npm run lint && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "next build",
    "build:windows": "npm run prepare:extra windows && npm run build && electron-builder --win",
    "build:mac": "npm run prepare:extra mac && npm run build && electron-builder --mac",
    "build:linux": "npm run prepare:extra linux && npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.cafeca.isuncloud",
    "asar": true,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "dist_renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      "./extra/**",
      "./services/**"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      },
      "icon": "src/assets/icon.png"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSFaceIDUsageDescription": "This app needs access to the Face ID"
      },
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "icon": "src/assets/icon.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@emnapi/runtime": "^1.7.1",
    "@next/eslint-plugin-next": "^16.0.10",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/systeminformation": "^3.23.1",
    "autoprefixer": "^10.4.16",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "globals": "^16.5.0",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "postcss": "^8.4.31",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "dependencies": {
    "systeminformation": "^5.27.13"
  }
}